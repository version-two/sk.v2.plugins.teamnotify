import jetbrains.buildServer.configs.kotlin.*
import jetbrains.buildServer.configs.kotlin.buildFeatures.buildFeature
import jetbrains.buildServer.configs.kotlin.buildSteps.gradle
import jetbrains.buildServer.configs.kotlin.buildSteps.script
import jetbrains.buildServer.configs.kotlin.triggers.vcs

/*
 * Example TeamCity Kotlin DSL configuration with TeamNotify webhooks.
 *
 * Webhooks are configured as the `teamnotify.webhook` build feature (there is no custom
 * DSL extension). See DSL_USAGE.md for the full parameter reference.
 *
 * SECURITY NOTE: Use TeamCity password parameters for webhook URLs and tokens.
 * NEVER hardcode webhook URLs directly in settings files.
 */

version = "2026.1"

project {
    // Define secure parameters for webhook URLs (set the values in the TeamCity UI, not here)
    params {
        password("slack.webhook.critical", "", label = "Slack Critical Alerts Webhook", display = ParameterDisplay.HIDDEN)
        password("teams.webhook.monitoring", "", label = "Teams Monitoring Webhook", display = ParameterDisplay.HIDDEN)
        password("discord.webhook.build", "", label = "Discord Build Webhook", display = ParameterDisplay.HIDDEN)
    }

    // Project-level webhook (inherited by all build configurations): critical failures to Slack
    features {
        buildFeature {
            type = "teamnotify.webhook"
            param("webhook.url", "%slack.webhook.critical%")
            param("webhook.platform", "SLACK")
            param("webhook.enabled", "true")
            param("webhook.onFirstFailure", "true")
            param("webhook.onBuildFixed", "true")
        }

        // All build events to Teams for monitoring
        buildFeature {
            type = "teamnotify.webhook"
            param("webhook.url", "%teams.webhook.monitoring%")
            param("webhook.platform", "TEAMS")
            param("webhook.enabled", "true")
            param("webhook.onStart", "true")
            param("webhook.onSuccess", "true")
            param("webhook.onFailure", "true")
            param("webhook.buildLongerThanAverage", "true")
        }
    }

    buildType(Build)
}

object Build : BuildType({
    name = "Build Application"

    vcs {
        root(DslContext.settingsRoot)
    }

    steps {
        gradle {
            tasks = "clean build"
        }
    }

    triggers {
        vcs {
            branchFilter = "+:*"
        }
    }

    // Build-configuration-specific webhook: failures and slow builds to Discord
    features {
        buildFeature {
            type = "teamnotify.webhook"
            param("webhook.url", "%discord.webhook.build%")
            param("webhook.platform", "DISCORD")
            param("webhook.enabled", "true")
            param("webhook.onFailure", "true")
            param("webhook.buildLongerThan", "600") // seconds
            param("webhook.branchFilter", "+:*,-:feature/*")
        }
    }
})
